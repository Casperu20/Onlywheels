# Copy to backend/.env and fill in. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL – pick ONE of the options from docs/SETUP.md
# Local (native install or infra/docker-compose.yml):
DATABASE_URL=postgres://onlywheels:onlywheels@localhost:5432/onlywheels
# Supabase (Project Settings -> Database -> Connection string, "Session pooler"):
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Frontend dev server (Vite). Used for CORS/CSRF and links in emails.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Celery – eager mode runs tasks inline, no Redis needed
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=memory://

# Email – printed in the terminal during development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=OnlyWheels <no-reply@onlywheels.local>

# Google login – OAuth 2.0 Web client ID from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=

# Real vehicle list + fitment for all European cars (free Sandbox key: developer.wheel-size.com).
# Empty = only the 13 demo cars from seed_demo.
WHEEL_SIZE_API_KEY=
WHEEL_SIZE_REGION=eudm

# Business
VAT_RATE=0.21
SHIPPING_FLAT_RATE=25.00
FREE_SHIPPING_THRESHOLD=1000.00
ORDER_RESERVATION_MINUTES=30

# Payments: fake (local only), stripe, or netopia (sandbox by default)
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# NETOPIA v2: use sandbox credentials with NETOPIA_MODE=sandbox; live credentials are separate.
# The notification URL must be publicly reachable over HTTPS (use a tunnel during local testing).
NETOPIA_MODE=sandbox
NETOPIA_API_KEY=
NETOPIA_POS_SIGNATURE=
NETOPIA_NOTIFY_URL=
NETOPIA_PUBLIC_KEY=
NETOPIA_POS_SIGNATURE_SET=

# SmartBill V1 issues real account documents; keep disabled until a test account is confirmed.
# All exact series/tax/unit names are account-specific. Do not copy example values into a live account.
SMARTBILL_ENABLED=False
SMARTBILL_API_BASE_URL=https://ws.smartbill.ro/SBORO/api
SMARTBILL_USER=
SMARTBILL_TOKEN=
SMARTBILL_CIF=
SMARTBILL_SERIES=
SMARTBILL_TAX_NAME=
SMARTBILL_MEASURING_UNIT=
# When SmartBill is disabled, issue a local "DEMO" mock-up PDF (not a fiscal document) instead of failing.
# Defaults to True in dev settings; production refuses to start with it enabled.
#SMARTBILL_DEMO=True
# Courier AWB. Empty SHIPPING_CARRIER = disabled (staff ship manually). sameday | fan_courier | demo
# (demo = simulated AWBs and labels, no account; refused in production).
# SHIPPING_MODE=sandbox uses the Sameday demo host / a FAN test account; "live" creates billable AWBs.
SHIPPING_CARRIER=
SHIPPING_MODE=sandbox
SAMEDAY_USERNAME=
SAMEDAY_PASSWORD=
# IDs from GET /api/client/pickup-points and /api/client/services of your Sameday account.
SAMEDAY_PICKUP_POINT_ID=
SAMEDAY_SERVICE_ID=
# SAMEDAY_API_BASE_URL=            # optional host override
# SAMEDAY_TRACKING_URL=https://sameday.ro/#awb={awb}
FAN_COURIER_CLIENT_ID=
FAN_COURIER_USERNAME=
FAN_COURIER_PASSWORD=
FAN_COURIER_SERVICE=Standard
# FAN_COURIER_API_BASE_URL=https://api.fancourier.ro
# FAN_COURIER_TRACKING_URL=https://www.fancourier.ro/awb-tracking/?awb={awb}

# AI photo studio. Empty AI_STUDIO_PROVIDER = disabled (page explains it is unavailable). replicate | fal.
# Every generation costs real money: the per-user quota and the global daily USD budget cap spend.
AI_STUDIO_PROVIDER=
AI_STUDIO_DAILY_QUOTA=5
AI_STUDIO_DAILY_BUDGET_USD=5.00
AI_STUDIO_RETENTION_DAYS=30
# AI_STUDIO_PRIVATE_ROOT=          # default backend/private-media/ai (never served publicly)
# AI_STUDIO_PRIVATE_BUCKET=        # production: private S3/R2 bucket instead of local disk
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro
REPLICATE_COST_PER_IMAGE_USD=0.04
FAL_KEY=
FAL_MODEL=fal-ai/flux-pro/kontext
FAL_COST_PER_IMAGE_USD=0.04

# --- Optional / production (leave empty in development) ----------------------
# Redis (cache + Celery). With Redis set CELERY_TASK_ALWAYS_EAGER=False and run a worker + beat.
# CACHE_URL=rediscache://localhost:6379/1
# CELERY_BROKER_URL=redis://localhost:6379/0

# Email provider (Resend via django-anymail)
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# RESEND_API_KEY=

# File uploads on S3-compatible storage (Cloudflare R2 / AWS S3 / MinIO)
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_CUSTOM_DOMAIN=media.onlywheels.ro

# Error tracking + logs
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# LOG_FORMAT=console          # json in production
# LOG_LEVEL=INFO

# Content Security Policy for admin/API docs (default: on when DJANGO_DEBUG=False)
# CSP_ENABLED=True
