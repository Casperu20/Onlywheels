# Copy to frontend/.env.local (not committed).

# Where Vite forwards /api and /media during development
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Leave empty in dev (same origin via proxy). In production: https://api.your-domain.ro
VITE_API_URL=

# OAuth 2.0 Web client ID (same value as GOOGLE_OAUTH_CLIENT_ID in backend/.env)
VITE_GOOGLE_CLIENT_ID=

# Error tracking (sentry.io, project type React). Empty = disabled.
VITE_SENTRY_DSN=
