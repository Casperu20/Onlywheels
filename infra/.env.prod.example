# Copy to infra/.env.prod (never commit the real file). Used by docker-compose.prod.yml.
# DATABASE_URL, CELERY_BROKER_URL and CACHE_URL are set by the compose file.

POSTGRES_PASSWORD=change-me

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=onlywheels.ro,www.onlywheels.ro
FRONTEND_URL=https://onlywheels.ro
CORS_ALLOWED_ORIGINS=https://onlywheels.ro
CSRF_TRUSTED_ORIGINS=https://onlywheels.ro

GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

EMAIL_BACKEND=anymail.backends.resend.EmailBackend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=OnlyWheels <comenzi@onlywheels.ro>

# Optional: uploads on Cloudflare R2 instead of the local "media" volume
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VITE_SENTRY_DSN=
LOG_LEVEL=INFO

# Port nginx listens on, on the host
HTTP_PORT=80
